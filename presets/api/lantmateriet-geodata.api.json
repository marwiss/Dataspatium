{
  "format": "dataspatium-api/1",
  "id": "lantmateriet-geodata",
  "name": "Lantmäteriet öppna geodata (katalog)",
  "publisher": "Lantmäteriet",
  "description": "Katalog (STAC) över Lantmäteriets öppna vektordata: ortnamn, administrativ indelning, topografi med mera, med nedladdningslänkar. Filerna laddas ned i webbläsaren och importeras sedan som filer.",
  "docs": "https://www.lantmateriet.se/sv/geodata/vara-produkter/oppna-data/",
  "license": { "name": "CC0 1.0", "url": "https://creativecommons.org/publicdomain/zero/1.0/" },
  "level": 1,
  "baseUrl": "https://api.lantmateriet.se/stac-vektor/v1",
  "auth": { "type": "none" },
  "endpoints": [
    {
      "id": "collections",
      "name": "Produkter (samlingar)",
      "method": "GET",
      "path": "/collections",
      "response": { "format": "json", "path": "collections", "drop": ["links", "stac_version", "stac_extensions", "type"], "rename": { "id": "produkt", "title": "titel", "description": "beskrivning", "license": "licens" } },
      "dataset": { "name": "Lantmäteriet produkter" }
    },
    {
      "id": "items",
      "name": "Filer i en produkt",
      "method": "GET",
      "path": "/collections/{collection}/items",
      "params": [
        { "name": "collection", "in": "path", "label": "Produkt", "type": "string", "required": true, "optionsFrom": { "endpoint": "collections", "value": "produkt", "label": "titel" } },
        { "name": "limit", "in": "query", "type": "number", "default": 100, "hidden": true }
      ],
      "pagination": { "type": "link-rel", "path": "links", "rel": "next", "maxPages": 20 },
      "response": { "format": "geojson", "options": { "geometry": false }, "drop": ["links", "stac_version", "stac_extensions", "collection", "type"] },
      "dataset": { "name": "Lantmäteriet {collection} filer" }
    }
  ]
}
