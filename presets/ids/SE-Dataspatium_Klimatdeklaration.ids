<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: LicenseRef-PolyForm-Strict-1.0.0 -->
<!-- Dataspatium's own requirements for a preliminary climate declaration, written from open rules: the common property sets and
     base quantities of IFC (IfcOpenShell's templates of the schema), IfcMaterial.Category, and Boverket's four categories (load
     bearing parts, the climate envelope, interior walls), which the app reads from the IFC class, LoadBearing and IsExternal
     (Analysera, Mängder, Klimatdeklaration). No classification system is needed. -->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>SE-Dataspatium_Klimatdeklaration</title>
    <copyright>Dataspatium</copyright>
    <version>1.0</version>
    <description>Det en preliminär klimatdeklaration behöver ur modellen: om väggar, bjälklag, tak, pelare och balkar är bärande, om väggar, dörrar och fönster sitter i klimatskärmen, material med kategori på byggdelarna, och basmängder.</description>
    <date>2026-11-12</date>
    <purpose>Klimatdeklaration</purpose>
  </info>
  <specifications>
    <specification name="Väggen är bärande eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K01" description="Pset_WallCommon.LoadBearing är satt, på väggen eller dess typ." instructions="Ange om väggen är bärande.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWALL</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet><baseName><simpleValue>LoadBearing</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Bjälklaget eller takskivan är bärande eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K02" description="Pset_SlabCommon.LoadBearing är satt, även på takets skivor (IfcSlab ROOF)." instructions="Ange om bjälklaget eller takskivan är bärande.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSLAB</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_SlabCommon</simpleValue></propertySet><baseName><simpleValue>LoadBearing</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Taket är bärande eller inte" ifcVersion="IFC4X3_ADD2" identifier="K03" description="Pset_RoofCommon.LoadBearing är satt (IFC 4.3; i IFC4 bär takets skivor uppgiften)." instructions="Ange om taket är bärande.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCROOF</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_RoofCommon</simpleValue></propertySet><baseName><simpleValue>LoadBearing</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Pelaren är bärande eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K04" description="Pset_ColumnCommon.LoadBearing är satt." instructions="Ange om pelaren är bärande.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCCOLUMN</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_ColumnCommon</simpleValue></propertySet><baseName><simpleValue>LoadBearing</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Balken är bärande eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K05" description="Pset_BeamCommon.LoadBearing är satt." instructions="Ange om balken är bärande.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBEAM</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_BeamCommon</simpleValue></propertySet><baseName><simpleValue>LoadBearing</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Väggen sitter i klimatskärmen eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K06" description="Pset_WallCommon.IsExternal är satt." instructions="Ange om väggen är en yttervägg.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWALL</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet><baseName><simpleValue>IsExternal</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Dörren sitter i klimatskärmen eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K07" description="Pset_DoorCommon.IsExternal är satt." instructions="Ange om dörren är en ytterdörr.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_DoorCommon</simpleValue></propertySet><baseName><simpleValue>IsExternal</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Fönstret sitter i klimatskärmen eller inte" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K08" description="Pset_WindowCommon.IsExternal är satt." instructions="Ange om fönstret sitter i en yttervägg eller ett tak.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWINDOW</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required"><propertySet><simpleValue>Pset_WindowCommon</simpleValue></propertySet><baseName><simpleValue>IsExternal</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Byggdelen har material" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="K09" description="Väggar, bjälklag, pelare och balkar har ett material, gärna som skikt på typen." instructions="Ge byggdelen dess material, helst som materialskikt på typen.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><xs:restriction base="xs:string"><xs:enumeration value="IFCWALL"/><xs:enumeration value="IFCSLAB"/><xs:enumeration value="IFCCOLUMN"/><xs:enumeration value="IFCBEAM"/></xs:restriction></name></entity>
      </applicability>
      <requirements>
        <material cardinality="required"/>
      </requirements>
    </specification>
    <specification name="Materialet har en kategori" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K10" description="IfcMaterial.Category är satt, till exempel concrete, steel, wood, brick eller gypsum." instructions="Ange materialets kategori.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCMATERIAL</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Category</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Väggen har basmängder" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K11" description="Qto_WallBaseQuantities med GrossSideArea och GrossVolume." instructions="Räkna väggens basmängder.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWALL</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Qto_WallBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossSideArea</simpleValue></baseName></property>
        <property dataType="IFCVOLUMEMEASURE" cardinality="required"><propertySet><simpleValue>Qto_WallBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossVolume</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Bjälklaget har basmängder" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K12" description="Qto_SlabBaseQuantities med GrossArea och GrossVolume." instructions="Räkna bjälklagets basmängder.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSLAB</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Qto_SlabBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossArea</simpleValue></baseName></property>
        <property dataType="IFCVOLUMEMEASURE" cardinality="required"><propertySet><simpleValue>Qto_SlabBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossVolume</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Taket har basmängder" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K13" description="Qto_RoofBaseQuantities med GrossArea." instructions="Räkna takets basmängder.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCROOF</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" cardinality="required"><propertySet><simpleValue>Qto_RoofBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossArea</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Pelaren har basmängder" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K14" description="Qto_ColumnBaseQuantities med GrossVolume." instructions="Räkna pelarens basmängder.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCCOLUMN</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCVOLUMEMEASURE" cardinality="required"><propertySet><simpleValue>Qto_ColumnBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossVolume</simpleValue></baseName></property>
      </requirements>
    </specification>
    <specification name="Balken har basmängder" ifcVersion="IFC4 IFC4X3_ADD2" identifier="K15" description="Qto_BeamBaseQuantities med GrossVolume." instructions="Räkna balkens basmängder.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBEAM</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCVOLUMEMEASURE" cardinality="required"><propertySet><simpleValue>Qto_BeamBaseQuantities</simpleValue></propertySet><baseName><simpleValue>GrossVolume</simpleValue></baseName></property>
      </requirements>
    </specification>
  </specifications>
</ids>
