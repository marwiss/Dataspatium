<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: LicenseRef-PolyForm-Strict-1.0.0 -->
<!-- Dataspatium's own requirements, written from open rules (buildingSMART's IFC documentation and the bSI rules OJT001 and
     IFC102, and the naming rules of the guidance Praxi in the app's own words); no text, list or template of Praxi is copied.
     The pattern in the PredefinedType specifications takes every value except an empty one and the words NOTDEFINED and
     USERDEFINED themselves, so that a standard value passes and so does USERDEFINED with an ObjectType, which IDS reads as the
     ObjectType; USERDEFINED without one fails. -->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>SE-Dataspatium_Grund</title>
    <copyright>Dataspatium</copyright>
    <version>1.0</version>
    <description>Grundkrav på en byggnadsmodell: namn på plats, byggnad, våningar och rum, inga proxyelement, och en PredefinedType på bjälklag, tak, dörrar, fönster och beklädnader.</description>
    <date>2026-11-12</date>
    <purpose>Grunduppgifter för varje syfte</purpose>
  </info>
  <specifications>
    <specification name="Platsen har ett namn" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G01" description="IfcSite.Name är satt, till exempel fastighetsbeteckningen." instructions="Ge platsen ett namn.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSITE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Byggnaden har ett namn" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G02" description="IfcBuilding.Name är satt, till exempel byggnadens nummer." instructions="Ge byggnaden ett namn eller nummer.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBUILDING</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Våningen har ett namn" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G03" description="IfcBuildingStorey.Name är satt." instructions="Ge varje våning ett namn.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Rummet har ett nummer" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G04" description="IfcSpace.Name är satt: rummets nummer; namnet står i LongName." instructions="Ge varje rum ett nummer i Name.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Inga proxyelement" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G05" description="Ingen byggdel är IfcBuildingElementProxy; varje byggdel har den klass som säger vad den är." instructions="Byt proxyelementen mot den klass som passar.">
      <applicability minOccurs="0" maxOccurs="0">
        <entity><name><simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue></name></entity>
      </applicability>
    </specification>
    <specification name="Bjälklaget har en PredefinedType" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G06" description="IfcSlab har en PredefinedType, på elementet eller dess typ, och inte NOTDEFINED: FLOOR, ROOF, BASESLAB och så vidare." instructions="Ange bjälklagets PredefinedType, helst på typen.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSLAB</simpleValue></name></entity>
      </applicability>
      <requirements>
        <entity>
          <name><simpleValue>IFCSLAB</simpleValue></name>
          <predefinedType><xs:restriction base="xs:string"><xs:pattern value="[^NU].*|N([^O].*)?|NO([^T].*)?|NOT([^D].*)?|NOTD([^E].*)?|NOTDE([^F].*)?|NOTDEF([^I].*)?|NOTDEFI([^N].*)?|NOTDEFIN([^E].*)?|NOTDEFINE([^D].*)?|NOTDEFINED.+|U([^S].*)?|US([^E].*)?|USE([^R].*)?|USER([^D].*)?|USERD([^E].*)?|USERDE([^F].*)?|USERDEF([^I].*)?|USERDEFI([^N].*)?|USERDEFIN([^E].*)?|USERDEFINE([^D].*)?|USERDEFINED.+"/></xs:restriction></predefinedType>
        </entity>
      </requirements>
    </specification>
    <specification name="Taket har en form" ifcVersion="IFC4 IFC4X3_ADD2" identifier="G07" description="IfcRoof har en PredefinedType, till exempel GABLE_ROOF eller FLAT_ROOF, och inte NOTDEFINED." instructions="Ange takets form som PredefinedType.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCROOF</simpleValue></name></entity>
      </applicability>
      <requirements>
        <entity>
          <name><simpleValue>IFCROOF</simpleValue></name>
          <predefinedType><xs:restriction base="xs:string"><xs:pattern value="[^NU].*|N([^O].*)?|NO([^T].*)?|NOT([^D].*)?|NOTD([^E].*)?|NOTDE([^F].*)?|NOTDEF([^I].*)?|NOTDEFI([^N].*)?|NOTDEFIN([^E].*)?|NOTDEFINE([^D].*)?|NOTDEFINED.+|U([^S].*)?|US([^E].*)?|USE([^R].*)?|USER([^D].*)?|USERD([^E].*)?|USERDE([^F].*)?|USERDEF([^I].*)?|USERDEFI([^N].*)?|USERDEFIN([^E].*)?|USERDEFINE([^D].*)?|USERDEFINED.+"/></xs:restriction></predefinedType>
        </entity>
      </requirements>
    </specification>
    <specification name="Dörren har en PredefinedType" ifcVersion="IFC4 IFC4X3_ADD2" identifier="G08" description="IfcDoor har en PredefinedType, till exempel DOOR eller GATE, och inte NOTDEFINED." instructions="Ange dörrens PredefinedType.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <entity>
          <name><simpleValue>IFCDOOR</simpleValue></name>
          <predefinedType><xs:restriction base="xs:string"><xs:pattern value="[^NU].*|N([^O].*)?|NO([^T].*)?|NOT([^D].*)?|NOTD([^E].*)?|NOTDE([^F].*)?|NOTDEF([^I].*)?|NOTDEFI([^N].*)?|NOTDEFIN([^E].*)?|NOTDEFINE([^D].*)?|NOTDEFINED.+|U([^S].*)?|US([^E].*)?|USE([^R].*)?|USER([^D].*)?|USERD([^E].*)?|USERDE([^F].*)?|USERDEF([^I].*)?|USERDEFI([^N].*)?|USERDEFIN([^E].*)?|USERDEFINE([^D].*)?|USERDEFINED.+"/></xs:restriction></predefinedType>
        </entity>
      </requirements>
    </specification>
    <specification name="Fönstret har en PredefinedType" ifcVersion="IFC4 IFC4X3_ADD2" identifier="G09" description="IfcWindow har en PredefinedType, till exempel WINDOW eller SKYLIGHT, och inte NOTDEFINED." instructions="Ange fönstrets PredefinedType.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWINDOW</simpleValue></name></entity>
      </applicability>
      <requirements>
        <entity>
          <name><simpleValue>IFCWINDOW</simpleValue></name>
          <predefinedType><xs:restriction base="xs:string"><xs:pattern value="[^NU].*|N([^O].*)?|NO([^T].*)?|NOT([^D].*)?|NOTD([^E].*)?|NOTDE([^F].*)?|NOTDEF([^I].*)?|NOTDEFI([^N].*)?|NOTDEFIN([^E].*)?|NOTDEFINE([^D].*)?|NOTDEFINED.+|U([^S].*)?|US([^E].*)?|USE([^R].*)?|USER([^D].*)?|USERD([^E].*)?|USERDE([^F].*)?|USERDEF([^I].*)?|USERDEFI([^N].*)?|USERDEFIN([^E].*)?|USERDEFINE([^D].*)?|USERDEFINED.+"/></xs:restriction></predefinedType>
        </entity>
      </requirements>
    </specification>
    <specification name="Beklädnaden har en PredefinedType" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="G10" description="IfcCovering har en PredefinedType, till exempel FLOORING, CEILING eller CLADDING, och inte NOTDEFINED." instructions="Ange beklädnadens PredefinedType.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCCOVERING</simpleValue></name></entity>
      </applicability>
      <requirements>
        <entity>
          <name><simpleValue>IFCCOVERING</simpleValue></name>
          <predefinedType><xs:restriction base="xs:string"><xs:pattern value="[^NU].*|N([^O].*)?|NO([^T].*)?|NOT([^D].*)?|NOTD([^E].*)?|NOTDE([^F].*)?|NOTDEF([^I].*)?|NOTDEFI([^N].*)?|NOTDEFIN([^E].*)?|NOTDEFINE([^D].*)?|NOTDEFINED.+|U([^S].*)?|US([^E].*)?|USE([^R].*)?|USER([^D].*)?|USERD([^E].*)?|USERDE([^F].*)?|USERDEF([^I].*)?|USERDEFI([^N].*)?|USERDEFIN([^E].*)?|USERDEFINE([^D].*)?|USERDEFINED.+"/></xs:restriction></predefinedType>
        </entity>
      </requirements>
    </specification>
  </specifications>
</ids>
